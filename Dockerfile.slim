FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3-pip python3-dev git wget xz-utils \
        libgl1 libglib2.0-0 build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

# modern static ffmpeg with both NVENC and NVDEC support (distro/pip ffmpeg
# builds predate this driver's NVENC/NVDEC API and lack cuvid decoders)
RUN wget -q https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz -O /tmp/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp && \
    cp /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /usr/local/bin/ffmpeg && \
    cp /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffprobe /usr/local/bin/ffprobe && \
    rm -rf /tmp/ffmpeg*

RUN pip install --no-cache-dir \
        torch==2.1.2 torchvision==0.16.2 torchaudio==2.1.2 --index-url https://download.pytorch.org/whl/cu118

# mediapipe/others pull in plain CPU-only onnxruntime as a transitive dep,
# which shares onnxruntime-gpu's import namespace and silently wins if it
# installs after onnxruntime-gpu. Uninstall it and reinstall the GPU build
# at the end of this SAME layer (not a separate RUN) so the discarded CPU
# wheel's bytes never get committed to a layer in the first place.
RUN pip install --no-cache-dir \
        tensorrt==8.6.1 \
        onnx \
        pycuda \
        numpy==1.26.4 \
        opencv-python \
        gradio \
        scikit-image \
        insightface \
        "huggingface_hub[cli]==0.23.5" \
        mediapipe \
        torchgeometry \
        omegaconf \
        ffmpeg-python \
        "transformers<4.50" \
        pykalman \
        tqdm \
    && pip uninstall -y onnxruntime \
    && pip install --no-cache-dir onnxruntime-gpu==1.17.0 \
    && pip install --no-cache-dir "numpy==1.26.4"

WORKDIR /root/FasterLivePortrait
COPY . /root/FasterLivePortrait

CMD ["bash"]
