# Leanest image for the actual CI use case: inference.py's human/lip-only,
# TensorRT-only (predict_type: trt) video-driving path.
#
# One CUDA 13 stack, all from NVIDIA: the official nvidia/cuda base, NVIDIA's
# tensorrt-cu13 wheels and the nvidia-* CUDA 13 wheels torch depends on.
#
# Versions:
# - TensorRT 11: its built-in GridSample takes 5D input, so the stock
#   warping_spade.onnx builds without the old grid_sample_3d plugin, and it
#   needs no cuDNN. Engines are strongly typed: fp16 ones are built from ONNX
#   converted with ModelOpt AutoCast (scripts/onnx2trt.py), in the `tools`
#   stage below.
# - torch: newest release, built for CUDA 13.0 (cu130), sharing TensorRT's
#   CUDA 13 libraries.
# - Base: the newest nvidia/cuda tag the runner's driver supports (CUDA 13.3,
#   driver 610). A newer tag needs a driver update first: the image refuses to
#   start on an older driver.
# - Ubuntu 24.04, Python 3.12.
#
# Left out because the CI path never imports them (their imports are lazy):
# onnxruntime/onnx (ONNX predictor), mediapipe (MediaPipeFaceModel),
# insightface (only its Face dict class was used, now in face_analysis_model),
# Pillow/imageio (animal path / skimage.io only), triton (torch.compile only),
# torchvision/torchaudio, gradio, JoyVASA deps.
#
# Stages:
# - deps: everything, incl. TensorRT's builder resources (~3.7 GB: one library
#   per GPU generation, each also for Windows), only needed to build engines.
# - tools: deps + ONNX/ModelOpt, for building engines on the target GPU:
#     docker build -f Dockerfile.slim --target tools -t flp-tools .
#     docker run --rm --gpus all -v $PWD/checkpoints:/workspace/checkpoints \
#       flp-tools bash scripts/all_onnx2trt.sh
# - runtime (default): deps' Python env without the builder resources.

FROM nvidia/cuda:13.3.1-base-ubuntu24.04 AS base
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
# modern static ffmpeg with both NVENC and NVDEC support (distro/pip ffmpeg
# builds predate this driver's NVENC/NVDEC API and lack cuvid decoders)
RUN python3 -c "import urllib.request as u; u.urlretrieve('https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz', '/tmp/ffmpeg.tar.xz')" && \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp && \
    cp /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffprobe /usr/local/bin/ && \
    rm -rf /tmp/ffmpeg*
# triton is torch.compile-only; scikit-image pulls Pillow/imageio for its io
# module, which face_align's skimage.transform doesn't use.
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cu130 \
    && pip install --no-cache-dir tensorrt-cu13==11.4.0.106 \
    && pip install --no-cache-dir opencv-python-headless scikit-image torchgeometry ffmpeg-python colorama omegaconf tqdm \
    && pip uninstall -y triton pillow imageio \
    && python -c "import tensorrt, torch; print('TensorRT', tensorrt.__version__, 'torch', torch.__version__)"

FROM deps AS tools
RUN pip install --no-cache-dir onnx "nvidia-modelopt[onnx]"
WORKDIR /workspace
COPY . /workspace

# TensorRT's builder resources only matter when building engines (tools stage).
# COPY --from takes a stage's resulting filesystem, so deleting them here keeps
# them out of the runtime image entirely.
FROM deps AS prune
RUN rm -f /opt/venv/lib/python3.12/site-packages/tensorrt_libs/libnvinfer_builder_resource* \
    && python -c "import tensorrt"

FROM base AS runtime
COPY --from=prune /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=prune /opt/venv /opt/venv
WORKDIR /workspace
COPY . /workspace

# TensorRT 11.4 engines for the human/lip-only inference.py CI path, built in
# the tools stage on the CI runner's RTX 4090 (engines are specific to the
# TensorRT version and tuned for the GPU they're built on), fetched from a
# GitHub Release: this repo is a fork, and GitHub blocks pushing new Git LFS
# objects into forks. Rebuild and re-upload under a new tag when TensorRT or
# the target GPU changes.
RUN mkdir -p checkpoints/liveportrait_onnx && \
    python -c "import urllib.request as u; u.urlretrieve('https://github.com/wegylexy/FasterLivePortrait/releases/download/checkpoints-liveportrait-trt11.4-sm89-v2/liveportrait_onnx_trt.tar.gz', '/tmp/ckpt.tar.gz')" && \
    echo "73469ac8d6b11956f2c9d2a1d374830314620c778d12a6992a19cbb44fdd8929  /tmp/ckpt.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/ckpt.tar.gz -C checkpoints/liveportrait_onnx && \
    rm /tmp/ckpt.tar.gz

# inference.py (a genuinely separate script, not an alias for run.py - see its
# own docstring) is the CI/production entrypoint matching the non-Faster fork's
# CLI and single-file output contract exactly.
ENV FLP_DEFAULT_CFG=configs/trt_infer_lip_ci.yaml
CMD ["bash"]
