# Leanest image for the actual CI use case: run.py's human/lip-only,
# TensorRT-only (predict_type: trt) video-driving path. No multi-stage
# builder needed - pycuda (the only thing that needed nvcc) turned out to
# be entirely unused dead weight (grep across the whole repo finds zero
# imports of it; TensorRT execution goes through the tensorrt Python API's
# own context/buffer handling, not pycuda). torchvision/torchaudio are also
# dropped: torchvision is only pulled in by the animal (XPose) path's lazy
# import, torchaudio only by JoyVASA/the gradio pipeline - neither is ever
# imported by run.py's actual call chain (FasterLivePortraitPipeline).
# Similarly gradio/huggingface_hub/transformers/pykalman/soundfile are
# JoyVASA/gradio-pipeline-only and dropped. mediapipe stays required even
# though our config never selects it - src/models/__init__.py imports it
# unconditionally at module load time.

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3-pip git wget xz-utils \
        libgl1 libglib2.0-0 libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

# modern static ffmpeg with both NVENC and NVDEC support (distro/pip ffmpeg
# builds predate this driver's NVENC/NVDEC API and lack cuvid decoders)
RUN wget -q https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz -O /tmp/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp && \
    cp /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /usr/local/bin/ffmpeg && \
    cp /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffprobe /usr/local/bin/ffprobe && \
    rm -rf /tmp/ffmpeg*

RUN pip install --no-cache-dir \
        torch==2.7.1 --index-url https://download.pytorch.org/whl/cu118

# mediapipe pulls in plain CPU-only onnxruntime as a transitive dep, which
# shares onnxruntime-gpu's import namespace and silently wins if it installs
# after onnxruntime-gpu. Uninstall it and reinstall the GPU build at the end
# of this SAME layer (not a separate RUN) so the discarded CPU wheel's
# bytes never get committed to a layer in the first place.
RUN pip install --no-cache-dir \
        tensorrt==8.6.1 \
        onnx \
        numpy==1.26.4 \
        opencv-python \
        scikit-image \
        insightface \
        mediapipe \
        torchgeometry \
        ffmpeg-python \
        colorama \
        omegaconf \
        tqdm \
        Pillow \
    && pip uninstall -y onnxruntime \
    && pip install --no-cache-dir onnxruntime-gpu==1.17.0 \
    && pip install --no-cache-dir "numpy==1.26.4"

WORKDIR /workspace
COPY . /workspace

# Prebuilt TensorRT 8.6.1 engines + precompiled libgrid_sample_3d_plugin.so
# for the human/lip-only inference.py CI path - GPU/driver-specific
# artifacts that can't be built in this stage (no GPU access during
# `docker build`), so they're fetched from a GitHub Release rather than
# committed to git: this repo is a fork, and GitHub outright blocks pushing
# new Git LFS objects into forks ("can not upload new objects to public
# fork"), tried first and hit that wall. Built once on an RTX 4070 (Ada,
# compute capability 8.9) against this same tensorrt==8.6.1 - rebuild and
# re-upload under a new release tag if the target GPU generation ever
# changes. This makes the image standalone: no volume mount or download
# step needed at container runtime, since CI job images can't rely on
# either.
RUN mkdir -p checkpoints/liveportrait_onnx && \
    wget -q https://github.com/wegylexy/FasterLivePortrait/releases/download/checkpoints-liveportrait-onnx-trt-v1/liveportrait_onnx_trt.tar.gz -O /tmp/ckpt.tar.gz && \
    echo "26f6237fd3735ff9f072e0120c1370d7a96e5e6698d7dd1d1e68c918a0f7c8ad  /tmp/ckpt.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/ckpt.tar.gz -C checkpoints/liveportrait_onnx && \
    rm /tmp/ckpt.tar.gz

# FLP_DEFAULT_CFG only changes run.py's --cfg default inside THIS image, not
# the repo's own general-purpose default (configs/onnx_infer.yaml) when
# run.py is invoked directly from a checkout instead of this container.
# inference.py (a genuinely separate script, not an alias for run.py - see
# its own docstring) is the CI/production entrypoint matching the non-Faster
# fork's CLI and single-file output contract exactly.
ENV FLP_DEFAULT_CFG=configs/trt_infer_lip_ci.yaml

CMD ["bash"]
